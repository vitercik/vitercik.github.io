{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign author_name = author_name | strip %}
{% if site.title == 'blank' or site.title == blank %}
  {% assign site_name = author_name %}
{% else %}
  {% assign site_name = site.title %}
{% endif %}

{% assign is_home = false %}
{% if page.url == '/' %}
  {% assign is_home = true %}
{% endif %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% assign page_title = page.title | default: '' %}
{% if is_home %}
  {% assign document_title = site_name %}
{% elsif page_title == 'blank' or page_title == blank %}
  {% capture document_title %}{{ page.date | date: '%Y' }} | {{ site_name }}{% endcapture %}
{% else %}
  {% capture document_title %}{{ page_title }} | {{ site_name }}{% endcapture %}
{% endif %}
{% assign document_title = document_title | strip %}
{% assign social_title = page.og_title | default: document_title | strip %}
{% assign meta_description = page.description | default: site.description | strip_newlines | strip %}
{% assign canonical_url = page.url | replace: 'index.html', '' | absolute_url %}

{% assign og_image_source = page.og_image | default: site.og_image %}
{% if og_image_source contains '://' %}
  {% assign og_image_url = og_image_source %}
{% elsif og_image_source %}
  {% assign og_image_url = og_image_source | absolute_url %}
{% endif %}
{% assign og_image_alt = page.og_image_alt | default: site.og_image_alt | default: social_title %}
{% assign og_image_width = page.og_image_width | default: site.og_image_width %}
{% assign og_image_height = page.og_image_height | default: site.og_image_height %}
{% assign og_image_type = page.og_image_type | default: site.og_image_type %}
{% assign og_locale = page.og_locale | default: site.og_locale | default: site.lang %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ document_title | escape }}</title>
<meta name="author" content="{{ author_name | escape }}">
<meta name="description" content="{{ meta_description | escape }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords | escape }}{% else %}{{ site.keywords | escape }}{% endif %}">
{% endif %}

{% if site.serve_og_meta %}
  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site_name | escape }}">
  <meta property="og:type" content="{% if is_home %}profile{% elsif is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ social_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ meta_description | escape }}">
  {% if og_image_url %}
    <meta property="og:image" content="{{ og_image_url }}">
    {% if og_image_type %}<meta property="og:image:type" content="{{ og_image_type }}">{% endif %}
    {% if og_image_width %}<meta property="og:image:width" content="{{ og_image_width }}">{% endif %}
    {% if og_image_height %}<meta property="og:image:height" content="{{ og_image_height }}">{% endif %}
    <meta property="og:image:alt" content="{{ og_image_alt | escape }}">
  {% endif %}
  <meta property="og:locale" content="{{ og_locale }}">
  {% if is_home %}
    <meta property="profile:first_name" content="{{ site.first_name | escape }}">
    <meta property="profile:last_name" content="{{ site.last_name | escape }}">
  {% endif %}

  <!-- X/Twitter card compatibility -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ social_title | escape }}">
  <meta name="twitter:description" content="{{ meta_description | escape }}">
  {% if og_image_url %}
    <meta name="twitter:image" content="{{ og_image_url }}">
    <meta name="twitter:image:alt" content="{{ og_image_alt | escape }}">
  {% endif %}
  {% assign x_username = site.data.socials.x_username | default: site.x_username %}
  {% if x_username %}
    <meta name="twitter:site" content="@{{ x_username }}">
    <meta name="twitter:creator" content="@{{ x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org and is_home and site.schema_person %}
  {% assign profile_page_id = canonical_url | append: '#profile-page' %}
  <!-- ProfilePage and Person identity graph -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfilePage",
          "@id": {{ profile_page_id | jsonify }},
          "url": {{ canonical_url | jsonify }},
          "name": {{ author_name | jsonify }},
          "description": {{ meta_description | jsonify }},
          "mainEntity": {
            "@id": {{ site.schema_person.id | jsonify }}
          }
        },
        {
          "@type": "Person",
          "@id": {{ site.schema_person.id | jsonify }},
          "name": {{ author_name | jsonify }},
          "givenName": {{ site.schema_person.given_name | jsonify }},
          "familyName": {{ site.schema_person.family_name | jsonify }},
          "url": {{ canonical_url | jsonify }},
          "image": {{ site.schema_person.image | jsonify }},
          "description": {{ meta_description | jsonify }},
          "jobTitle": {{ site.schema_person.job_title | jsonify }},
          "worksFor": {
            "@type": "CollegeOrUniversity",
            "@id": {{ site.schema_person.works_for.id | jsonify }},
            "name": {{ site.schema_person.works_for.name | jsonify }},
            "url": {{ site.schema_person.works_for.url | jsonify }}
          },
          "sameAs": {{ site.schema_person.same_as | jsonify }},
          "knowsAbout": {{ site.schema_person.knows_about | jsonify }}
        }
      ]
    }
  </script>
{% endif %}
